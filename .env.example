# Copy this file to .env.local and fill in the values.
# Get the keys from your Supabase project:
# https://supabase.com/dashboard/project/raxaicqhlbmyzngcubye/settings/api

# ============================================================
# Supabase — used by Next.js (client + server)
# ============================================================

# Public Supabase URL (safe to expose to client)
NEXT_PUBLIC_SUPABASE_URL=https://raxaicqhlbmyzngcubye.supabase.co

# Public anon key (safe to expose to client; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Supabase Edge Function secrets
#
# These are NOT read by Next.js. Set them via:
#   supabase secrets set RESEND_API_KEY=re_xxx ...
# (or via the dashboard: Project Settings → Edge Functions → Secrets)
#
# Listed here for documentation only.
# ============================================================

# Resend API key — used by Edge Functions to send emails
RESEND_API_KEY=

# Sender for outgoing emails. Use Resend's test sender until you verify
# your own domain in Resend (Settings → Domains).
EMAIL_FROM="Hand in Hand <onboarding@resend.dev>"

# Public URL of the deployed app — used to build links in emails
APP_URL=http://localhost:3000

# Webhook shared secret — authenticates database trigger calls to Edge Functions.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# ============================================================
# Web Push (Phase 4 part 2 — not yet wired)
# ============================================================

# VAPID public key (safe to expose to client)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# VAPID private key — Edge Function secret (set via supabase secrets set)
VAPID_PRIVATE_KEY=
