{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm biome *)",
			"Bash(pnpm exec biome *)",
			"Bash(pnpm tsc *)",
			"Bash(./node_modules/.bin/tsc *)",
			"Bash(pnpm vitest *)",
			"Bash(pnpm test)",
			"Bash(pnpm test *)",
			"Bash(pnpm build)",
			"Bash(pnpm exec supabase status)",
			"Bash(pnpm exec supabase start)",
			"Bash(pnpm exec supabase stop)",
			"Bash(pnpm exec supabase db reset)",
			"Bash(pnpm exec supabase test db)",
			"Bash(pnpm exec supabase db diff *)",
			"Bash(pnpm exec supabase gen types *)",
			"Bash(pnpm exec supabase migration list *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git show *)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(./supabase/.temp/**)",
			"Bash(pnpm exec supabase db reset --linked*)",
			"Bash(supabase db reset --linked*)",
			"Bash(pnpm exec supabase db push*)",
			"Bash(supabase db push*)"
		],
		"ask": [
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push --force-with-lease*)"
		]
	}
}
